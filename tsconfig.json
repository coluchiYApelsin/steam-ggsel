{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "skipLibCheck": true,
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    },
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "webview/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    "frontend/**/*.tsx"
  ]
}